# Copy to .env.local and fill in from your Supabase project (Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Only needed for scripts/seed.mjs (NEVER ship this to the client)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Email of the account to seed with sample data
SEED_EMAIL=you@example.com
